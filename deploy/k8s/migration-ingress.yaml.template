# A single-use protected ingress for copying the existing Sites state to the
# self-hosted importer. It is intentionally excluded from kustomization and
# must be deleted immediately after the transfer succeeds.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: okri-migration
  namespace: okri
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    external-dns.alpha.kubernetes.io/cloudflare-proxied: "true"
    external-dns.alpha.kubernetes.io/hostname: okri-migration.allvibe.ai
    external-dns.alpha.kubernetes.io/target: 61.72.248.246
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - okri-migration.allvibe.ai
      secretName: okri-migration-allvibe-ai-tls
  rules:
    - host: okri-migration.allvibe.ai
      http:
        paths:
          - path: /api/internal/migration-receiver
            pathType: Exact
            backend:
              service:
                name: okri
                port:
                  name: http
