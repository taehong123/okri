{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "environment": "development", "channel": "development" },
    "preview": { "distribution": "internal", "environment": "preview", "channel": "preview", "android": { "buildType": "apk" }, "ios": { "simulator": false } },
    "simulator": { "extends": "preview", "ios": { "simulator": true } },
    "production": { "autoIncrement": true, "environment": "production", "channel": "production" }
  },
  "submit": {
    "production": {
      "android": { "track": "internal", "releaseStatus": "draft" },
      "ios": {}
    }
  }
}
