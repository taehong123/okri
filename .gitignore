# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
!/mobile/release/update-certificate.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
# Deterministic install assets generated from the shared theme and offline source.
/public/manifest.webmanifest
/public/offline.html
/.wrangler/
/outputs/
/work/
*.tsbuildinfo

# local Codex/Sites verification and deployment artifacts
/.codex-remote-attachments/
/.deploy-*/
/.sites-*/
/.sites-*.tar
/.validate-*/
/.verify-*/
/test-results/
/debug.log
/okrptr-*.tar.gz
/okri-*.tar.gz
/*.patch
/%SystemDrive%/
